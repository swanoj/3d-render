# Mailing-list sign-ups are POSTed here as JSON: { email, source, subscribedAt }
NEWSLETTER_WEBHOOK_URL=

# Tag Manager and ad pixels: paste each platform's ID; leave one empty and that tag stays off.
# Google Tag Manager container, GTM-XXXXXXX
GTM_CONTAINER_ID=
# Meta Pixel (Facebook and Instagram), the number in Meta Events Manager
META_PIXEL_ID=
# TikTok Pixel, from TikTok Events Manager
TIKTOK_PIXEL_ID=
# Google Ads tag, AW-123456789 (remarketing)
GOOGLE_ADS_ID=
# Google Analytics 4, G-XXXXXXXXXX
GA_MEASUREMENT_ID=
# 'denied' keeps Google's advertising cookies off even with ad tags set
AD_CONSENT=
